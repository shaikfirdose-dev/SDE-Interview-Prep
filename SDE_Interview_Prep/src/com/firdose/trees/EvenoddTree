class Solution {

  public boolean isEvenOddTree(TreeNode root) {
    // ToDo: Write Your Code Here.
    Queue<TreeNode> q = new LinkedList<>();
    q.add(root);
    boolean flag = true;
    while (!q.isEmpty()) {
      int n = q.size();
      List<Integer> level = new ArrayList<>();
      for (int i = 0; i < n; i++) {
        TreeNode rem = q.remove();
        level.add(rem.val);

        if (rem.left != null) {
          q.add(rem.left);
        }

        if (rem.right != null) {
          q.add(rem.right);
        }
      }

      if (flag) {
        for (int i = 0; i < n; i++) {
          if (
            level.get(i) % 2 == 0 || (i > 0 && level.get(i - 1) >= level.get(i))
          ) {
            return false;
          }
        }
      } else {
        for (int i = 0; i < n; i++) {
          if (
            level.get(i) % 2 == 1 || (i > 0 && level.get(i - 1) <= level.get(i))
          ) {
            return false;
          }
        }
      }

      flag = !flag;
    }

    return true;
  }
}
